<?xml version="1.0" encoding="utf-8"?>
<!-- AI-assisted (Claude) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2FFF0"
    tools:context=".AppointmentMainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book an appointment"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/darkgreen" />

            <!-- Patient (read-only, will come from the account) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/whitegreen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booking for"
                        android:textSize="12sp"
                        android:textColor="@color/darkgreen" />

                    <TextView
                        android:id="@+id/tvPatientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient name"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/darkgreen" />

                    <TextView
                        android:id="@+id/tvPatientPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone number"
                        android:textSize="14sp"
                        android:textColor="@color/darkgreen" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hospital -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Hospital"
                android:textStyle="bold"
                android:textColor="#4F5D4C" />

            <Spinner
                android:id="@+id/spHospital"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Specialization -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Specialization"
                android:textStyle="bold"
                android:textColor="#4F5D4C" />

            <Spinner
                android:id="@+id/spSpecialization"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Doctor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Doctor"
                android:textStyle="bold"
                android:textColor="#4F5D4C" />

            <Spinner
                android:id="@+id/spDoctor"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Date"
                android:textStyle="bold"
                android:textColor="#4F5D4C" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select date"
                android:textColor="@color/darkgreen"
                app:strokeColor="@color/darkgreen" />

            <!-- Holiday message (hidden until needed) -->
            <TextView
                android:id="@+id/tvHolidayMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:textColor="#8A5300"
                tools:visibility="visible"
                tools:text="Closed on this date for a public holiday. Please choose another date." />

            <!-- Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Time"
                android:textStyle="bold"
                android:textColor="#4F5D4C" />

            <Spinner
                android:id="@+id/spTime"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyAppointments"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="My appointments"
                android:textColor="@color/darkgreen"
                app:strokeColor="@color/darkgreen" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Confirm booking"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/darkgreen" />
</LinearLayout>